{
  "schema_version": 1,
  "public_origin": "https://barnsey1210.github.io",
  "control_base_url": "https://control.barnseywr.com",
  "origin_policy": {
    "public_command_center": "https://barnsey1210.github.io",
    "protected_action_origin": "https://control.barnseywr.com",
    "wildcards_allowed": false
  },
  "origin": {
    "bind_host": "127.0.0.1",
    "port": 8787,
    "direct_internet_exposure": false
  },
  "authentication": {
    "owner": "CLOUDFLARE_ACCESS",
    "required_headers": [
      "Cf-Access-Jwt-Assertion",
      "Cf-Access-Authenticated-User-Email"
    ]
  },
  "allowed_routes": {
    "GET": ["/war-room/status", "/war-room/bootstrap", "/war-room/task/{task_id}", "/war-room/live/version", "/war-room/live/health", "/war-room/live/market-matrix", "/war-room/live/schedule"],
    "POST": ["/war-room/market", "/war-room/ratings", "/war-room/postgame"]
  },
  "public_live_reads": {
    "authentication": "CLOUDFLARE_ACCESS_BYPASS_ON_EXACT_PATH_ONLY",
    "cors_origin": "https://barnsey1210.github.io",
    "paths": ["/war-room/live/version", "/war-room/live/health", "/war-room/live/market-matrix", "/war-room/live/schedule"]
  },
  "browser_version_poll_seconds": 2,
  "activation_status": "CLOUDFLARE_ACCESS_TUNNEL_PROVISIONED"
}
