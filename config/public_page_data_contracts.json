{
  "schema_version": 1,
  "policy": {
    "live_market_stale_behavior": "show_stale_or_no_data_never_silent_cache",
    "page_build_time_is_not_source_freshness": true,
    "page_adapters_may_format_but_may_not_select_sources": true
  },
  "pages": {
    "index.html": ["current_market", "market_history", "ratings", "schedule", "futures", "betting", "injuries", "coaches", "conference"],
    "ratings.html": ["ratings"],
    "openers.html": ["current_market", "market_history", "ratings", "schedule"],
    "matchups.html": ["current_market", "market_history", "ratings", "schedule", "betting", "injuries", "coaches"],
    "odds.html": ["current_market", "market_history"],
    "schedule.html": ["schedule", "ratings", "current_market"],
    "futures.html": ["futures", "ratings", "betting"],
    "conferences.html": ["conference", "ratings", "futures", "schedule", "betting"],
    "playoff.html": ["futures", "ratings", "schedule"],
    "simulations.html": ["ratings", "schedule", "futures"],
    "betting.html": ["betting", "current_market", "market_history", "model_performance"],
    "team.html": ["ratings", "schedule", "current_market", "injuries", "coaches"],
    "coaches.html": ["coaches", "schedule", "current_market"],
    "v1.html": ["legacy_embedded_data"]
  },
  "contracts": {
    "current_market": {
      "authoritative_source": "accepted SGO quotes with explicit approved backup status",
      "required_fields": ["game_id", "market_timestamp", "source", "freshness_status", "reference_spread", "best_home", "best_away", "reference_total", "best_over", "best_under", "per_book_quotes"],
      "freshness_states": ["LIVE", "BACKUP_SOURCE", "STALE", "MISSING"]
    },
    "market_history": {"purpose": "historical snapshots only; never overrides current market"},
    "ratings": {"required_dates": ["source_updated_at", "pulled_at", "status_built_at", "applied_snapshot_date"]},
    "model_performance": {
      "standard_artifact": "data/site/model_performance_view.json",
      "historical_standard_artifacts": ["data/site/historical_model_performance_2021_2025.json", "data/site/historical_totals_model_performance_2021_2025.json"],
      "shadow_artifact": "data/site/shadow_model_performance.json",
      "shadow_builder": "scripts/site/build_shadow_model_performance.py",
      "shadow_policy": "historical statistics and presentation labels remain separate; labels are not automatic betting rules"
    }
  }
}
