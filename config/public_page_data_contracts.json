{
  "schema_version": 1,
  "policy": {
    "live_market_stale_behavior": "show_stale_or_no_data_never_silent_cache",
    "page_build_time_is_not_source_freshness": true,
    "page_adapters_may_format_but_may_not_select_sources": true
  },
  "pages": {
    "index.html": ["current_market", "market_history", "ratings", "schedule", "futures", "betting", "injuries", "coaches", "conference"],
    "war-room.html": ["war_room_market_matrix", "war_room_health", "war_room_activity", "game_projections", "current_market", "market_history", "ratings", "schedule", "betting", "injury_impact"],
    "ratings.html": ["ratings"],
    "openers.html": ["current_market", "market_history", "ratings", "schedule"],
    "matchups.html": ["current_market", "market_history", "ratings", "schedule", "betting", "injuries", "coaches"],
    "odds.html": ["current_market", "market_history"],
    "schedule.html": ["schedule", "ratings", "current_market"],
    "futures.html": ["futures", "ratings", "betting"],
    "conferences.html": ["conference", "ratings", "futures", "schedule", "betting"],
    "playoff.html": ["futures", "ratings", "schedule"],
    "simulations.html": ["ratings", "schedule", "futures"],
    "betting.html": ["betting", "current_market", "market_history", "historical_betting_analytics", "model_performance"],
    "team.html": ["ratings", "schedule", "current_market", "injuries", "coaches"],
    "coaches.html": ["coaches", "schedule", "current_market"],
    "v1.html": ["legacy_embedded_data"]
  },
  "contracts": {
    "war_room_health": {
      "artifact": "data/site/war_room_health.json",
      "builder": "scripts/war_room/build_war_room_health.py",
      "schema_version": "war-room-health-v1",
      "owner": "WAR_ROOM_HEALTH_PROJECTOR",
      "interactive_refresh": "scripts/war_room/run_fast_market_refresh.py",
      "live_read_route": "/war-room/live/health",
      "static_fallback": true
    },
    "war_room_market_matrix": {
      "artifact": "data/site/war_room_market_matrix.json",
      "builder": "scripts/war_room/build_war_room_market_matrix.py",
      "schema_version": "war-room-market-matrix-v1",
      "owner": "WAR_ROOM_MARKET_MATRIX_PROJECTOR",
      "live_read_route": "/war-room/live/market-matrix",
      "live_version_route": "/war-room/live/version",
      "static_fallback": true,
      "opener_contract": "market.openers uses earliest accepted canonical matchup line history; Pinnacle opener remains a separate canonical-history diagnostic",
      "movement_contract": "best_sportsbook quote may expose only its own latest >=0.5-point material move; no exchange markers or price-only moves",
      "first_market_contract": "market.first_available persists the first accepted spread and total availability independently; startup inventory is marked baseline and never emits false opening alerts",
      "shadow_tooltip_contract": "shadow_readiness.team_contributions exposes direct 50/50 team-level net decompositions of validated Spread and Total component updates plus readiness reasons; the browser only formats them",
      "recency_contract": "canonical opener and move timestamps age locally; latest plus two prior completed refresh ids support hybrid movement recency",
      "team_composite_rank_contract": "team_composite_rank.away/home copy the accepted ratings_view.teams.overall_rank values; no War Room ranking calculation",
      "injury_impact_contract": "injury_rank.away/home copy deterministic ascending CFBDepth Injury Impact ranks from the normalized canonical artifact; stale or missing inputs fail closed",
      "depends_on": ["war_room_health", "game_projections", "current_market", "ratings", "schedule", "betting", "injury_impact"]
    },
    "injury_impact": {
      "artifact": "data/canonical/cfbdepth_team_injury_impact_current.json",
      "builder": "scripts/injuries/pull_cfbdepth_team_injury_impact.py",
      "schema_version": "cfbdepth-team-injury-impact-v1",
      "owner": "INJURY_SOURCE_NORMALIZER",
      "source": "official public CFBDepth Injury Impact Report CSV export",
      "freshness_policy": "source_updated_at is never inferred from pulled_at; matrix ranks fail closed after six hours without a successful acquisition"
    },
    "war_room_activity": {
      "artifact": "data/site/war_room_activity.json",
      "builder": "scripts/war_room/build_war_room_activity.py",
      "schema_version": "war-room-activity-v1",
      "owner": "WAR_ROOM_ACTIVITY_PROJECTOR",
      "live_read_route": "/war-room/live/activity",
      "static_fallback": true,
      "history_artifact": "data/war_room/history/war_room_events.jsonl",
      "game_history_index": "data/war_room/history/war_room_game_activity_index.json",
      "game_history_schema": "war-room-game-activity-index-v1",
      "game_history_read_route": "/war-room/live/activity?game_id=<canonical_game_id>",
      "game_history_policy": "BOUNDED_MEANINGFUL_HISTORY_NOT_RAW_QUOTE_LEDGER",
      "depends_on": ["war_room_market_matrix", "war_room_health", "ratings", "schedule"]
    },
    "game_projections": {
      "artifact": "data/site/current_game_projection_contract.json",
      "builder": "scripts/projections/build_current_game_projection_contract.py",
      "resolver": "scripts/projections/projection_resolver.py",
      "status": "PRODUCTION_RESOLVER_ACTIVE",
      "active_standard_authority": {
        "spread_model_id": "standard_spread_4src_equal_v1",
        "spread_sources": ["SP+", "FPI", "TeamRankings", "DRatings"],
        "total_model_id": "standard_total_sp_massey_dratings_v1",
        "total_sources": ["SP+", "Massey Dual", "DRatings Total"]
      },
      "required_model_ids": [
        "standard_spread_degraded_v1",
        "standard_total_degraded_v1",
        "standard_spread_5src_legacy_v1",
        "standard_spread_4src_equal_v1",
        "standard_total_40_40_20_sagarin_legacy_v1",
        "standard_total_sp_massey_dratings_v1",
        "total_sp50_massey50_v1",
        "shadow_spread_sp_sagarin_v1",
        "shadow_total_enhanced_spplus_od_v1"
      ],
      "missing_component_policy": "OFFICIAL_MODELS_STRICT_SEPARATE_DEGRADED_IDENTITIES",
      "fallback_policy": "OFFICIAL_RESOLVER_AVAILABLE_ONLY_OPERATIONAL_SELECTOR_MAY_USE_EXPLICIT_DEGRADED_MODEL",
      "sign_policy": "explicit_value_home_margin_and_value_home_line"
    },
    "current_market": {
      "authoritative_source": "accepted The Odds API quotes with explicit approved backup status",
      "required_fields": ["game_id", "market_timestamp", "source", "freshness_status", "reference_spread", "best_home", "best_away", "reference_total", "best_over", "best_under", "per_book_quotes"],
      "freshness_states": ["LIVE", "BACKUP_SOURCE", "STALE", "MISSING"]
    },
    "market_history": {"purpose": "historical snapshots only; never overrides current market"},
    "ratings": {"required_dates": ["source_updated_at", "pulled_at", "status_built_at", "applied_snapshot_date"]},
    "model_performance": {
      "standard_artifact": "data/site/model_performance_view.json",
      "historical_standard_artifacts": ["data/site/historical_model_performance_2021_2025.json", "data/site/historical_totals_model_performance_2021_2025.json"],
      "shadow_artifact": "data/site/shadow_model_performance.json",
      "shadow_builder": "scripts/site/build_shadow_model_performance.py",
      "shadow_policy": "historical statistics and presentation labels remain separate; labels are not automatic betting rules"
    },
    "historical_betting_analytics": {
      "artifact": "data/site/historical_betting_analytics_v2.json",
      "builder": "scripts/site/build_historical_betting_analytics.py",
      "schema_version": "historical-betting-analytics-v2",
      "owner": "HISTORICAL_BETTING_ANALYTICS_PROJECTOR",
      "primary_spread_model_id": "standard_spread_4src_equal_v1",
      "legacy_spread_model_id": "standard_spread_5src_legacy_v1",
      "primary_total_historical_model_id": "total_sp50_massey50_v1",
      "legacy_total_model_id": "standard_total_40_40_20_sagarin_legacy_v1",
      "modes": ["INDEPENDENT_CHECKPOINT_PERFORMANCE", "MATCHED_SIGNAL_DECAY"],
      "missing_checkpoint_policy": "OMIT_OR_EXPLICITLY_UNAVAILABLE_NEVER_INTERPOLATE"
    }
  }
}
