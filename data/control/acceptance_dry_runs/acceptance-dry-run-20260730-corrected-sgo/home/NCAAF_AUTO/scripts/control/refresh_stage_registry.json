{
  "schema_version": 1,
  "policy": {
    "all_data_changing_modes_require_confirm_publish_for_acceptance": true,
    "automatic_publication_enabled": false,
    "dry_run_makes_provider_calls": false,
    "production_pipeline_replacement": false
  },
  "modes": {
    "status": {
      "description": "Read controller state only.",
      "stages": ["status_snapshot"]
    },
    "odds": {
      "description": "Refresh game odds and futures odds; default scope is both.",
      "default_scope": "both",
      "scopes": {
        "games": ["game_odds_pull", "game_history_append", "game_views", "validation", "publication_gate"],
        "futures": ["futures_pull", "futures_history_append", "futures_views", "validation", "publication_gate"],
        "both": ["game_odds_pull", "futures_pull", "game_history_append", "futures_history_append", "game_views", "futures_views", "validation", "publication_gate"]
      }
    },
    "ratings": {
      "description": "Acquire or stage rating sources, validate, accept last-known-good values, and rebuild projections.",
      "stages": ["ratings_acquisition", "ratings_validation", "ratings_acceptance_gate", "ratings_history", "projections", "shadow_components", "views", "validation", "publication_gate"]
    },
    "postgame": {
      "description": "Reuse canonical completed-game, PBP, game-control, and Shadow builders.",
      "stages": ["completed_results", "pbp_and_advanced", "game_control", "postgame_shadow", "shadow_components", "saturday_shadow_lines", "schedule_enrichment", "views", "validation", "publication_gate"]
    },
    "pregame": {
      "description": "Run ratings and odds orchestration before games without live/in-game behavior.",
      "stages": ["ratings_acquisition", "ratings_validation", "ratings_acceptance_gate", "game_odds_pull", "futures_pull", "history_append", "projections", "shadow_components", "views", "validation", "publication_gate"]
    },
    "full": {
      "description": "Canonical 8 AM orchestration; delegates to daily_market_update.sh rather than duplicating it.",
      "stages": ["daily_market_update_canonical", "validation", "publication_gate"]
    },
    "publish-existing": {
      "description": "Validate and publish already accepted canonical outputs; never calls providers.",
      "stages": ["canonical_publish_check", "publication_gate"]
    }
  },
  "stages": {
    "game_odds_pull": {
      "commands": [
        "python3 pull_cfbd_lines_2026.py",
        "python3 scripts/odds/pull_actionnetwork_ncaaf_game_lines_2026.py",
        "python3 scripts/odds/build_actionnetwork_season_lines_2026.py",
        "python3 build_season_game_lines_2026.py",
        "python3 pull_theodds_ncaaf_lines_2026.py",
        "python3 build_theodds_season_lines_2026.py"
      ],
      "providers": ["cfbd", "action_games", "the_odds_api"]
    },
    "futures_pull": {
      "commands": [
        "python3 pull_actionnetwork_win_totals_api.py",
        "python3 scripts/odds/pull_actionnetwork_visible_dk_win_totals.py",
        "python3 scripts/odds/merge_visible_dk_win_totals.py",
        "python3 pull_fanduel_win_totals.py",
        "python3 pull_bettingpros_caesars_win_totals.py",
        "python3 pull_actionnetwork_conference_futures_api.py",
        "python3 scripts/markets/pull_actionnetwork_playoff_futures.py"
      ],
      "providers": ["action_futures", "fanduel", "bettingpros"]
    },
    "game_history_append": {
      "commands": ["python3 scripts/odds/append_game_line_history.py", "python3 scripts/odds/build_game_line_movement_report.py"]
    },
    "futures_history_append": {
      "commands": ["python3 append_market_history.py", "python3 build_daily_market_movement_report.py", "python3 build_market_arbitrage_report.py"]
    },
    "ratings_acquisition": {
      "commands": ["source-specific acquisition into data/ratings/raw/*; manual sources remain manual", "python3 scripts/ratings/pull_sagarin_ratings.py", "python3 scripts/ratings/parse_massey_visible_ratings.py", "python3 scripts/ratings/pull_donchess_ratings.py"]
    },
    "ratings_validation": {
      "commands": ["python3 scripts/ratings/build_all_ratings_latest.py"]
    },
    "ratings_history": {
      "commands": ["python3 scripts/ratings/append_ratings_history.py", "python3 scripts/ratings/build_ratings_movement.py"]
    },
    "projections": {
      "commands": ["python3 scripts/projections/build_game_projection_sources_2026.py", "python3 scripts/projections/build_game_projection_blend_2026.py"]
    },
    "postgame_shadow": {
      "commands": ["python3 scripts/site/build_postgame_shadow_updates.py"],
      "outputs": ["data/site/postgame_shadow_updates.json"]
    },
    "shadow_components": {
      "commands": ["python3 scripts/site/build_shadow_team_game_features.py --mode all", "python3 scripts/site/build_saturday_shadow_component_predictions.py"],
      "outputs": ["data/site/saturday_shadow_component_predictions.json"]
    },
    "saturday_shadow_lines": {
      "commands": ["python3 scripts/site/build_saturday_shadow_lines.py"],
      "outputs": ["data/site/saturday_shadow_lines.json", "data/site/saturday_shadow_lines.csv", "data/history/saturday_shadow_line_snapshots.csv"]
    },
    "schedule_enrichment": {
      "commands": ["python3 scripts/site/build_schedule_live_enrichment.py"],
      "outputs": ["data/site/schedule_live_enrichment.json"]
    },
    "game_views": {
      "commands": ["python3 scripts/site/build_matchups_view.py", "python3 scripts/history/build_matchup_line_history_clean.py", "python3 scripts/site/build_odds_screen_v2.py"]
    },
    "futures_views": {
      "commands": ["python3 scripts/site/build_futures_view.py", "python3 scripts/site/build_odds_futures_v2.py"]
    },
    "views": {
      "commands": ["python3 scripts/site/build_public_site.py"]
    },
    "validation": {
      "commands": ["bash scripts/publish/publish_site.sh --check"]
    },
    "daily_market_update_canonical": {
      "commands": ["NCAAF_AUTO_PUBLISH=0 bash daily_market_update.sh"]
    },
    "canonical_publish_check": {
      "commands": ["bash scripts/publish/publish_site.sh --check"]
    },
    "publication_gate": {
      "commands": ["bash scripts/publish/publish_site.sh --push"],
      "requires": ["--confirm-publish", "automatic_publication_enabled=true", "all validations passed"]
    }
  }
}
